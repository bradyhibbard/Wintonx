<UserControl x:Class="Winton.Views.Dashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">

    <Grid Background="#F5F5F5">

        <!-- ROWS: Summary row + charts row -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="15"
                    HorizontalAlignment="Left">


            <Border Background="#CCFFFFFF"
                    CornerRadius="10"
                    Padding="15"
                    Margin="5"
                    Width="250">
                <Border.Effect>
                    <DropShadowEffect Color="#33000000" BlurRadius="20" ShadowDepth="0"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Annual Revenue"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="#444"/>

                    <TextBlock Text="{Binding TotalRevenue, StringFormat=C}"
                               FontSize="26"
                               FontWeight="Bold"
                               Margin="0,8,0,0"
                               Foreground="#222"/>
                </StackPanel>
            </Border>

            <!-- Current Month Revenue -->
            <Border Background="#CCFFFFFF"
                    CornerRadius="10"
                    Padding="15"
                    Margin="5"
                    Width="250">
                <Border.Effect>
                    <DropShadowEffect Color="#33000000" BlurRadius="20" ShadowDepth="0"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Current Month Revenue"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="#444"/>

                    <TextBlock Text="{Binding MonthlyRevenue, StringFormat=C}"
                               FontSize="26"
                               FontWeight="Bold"
                               Margin="0,8,0,0"
                               Foreground="#222"/>
                </StackPanel>
            </Border>

            <!-- Total Customers -->
            <Border Background="#CCFFFFFF"
                    CornerRadius="10"
                    Padding="15"
                    Margin="5"
                    Width="250">
                <Border.Effect>
                    <DropShadowEffect Color="#33000000" BlurRadius="20" ShadowDepth="0"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Total Customers"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="#444"/>

                    <TextBlock Text="{Binding TotalCustomers}"
                               FontSize="26"
                               FontWeight="Bold"
                               Margin="0,8,0,0"
                               Foreground="#222"/>
                </StackPanel>
            </Border>

        </StackPanel>


        <Grid Grid.Row="1" Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Revenue Chart -->
            <Border Grid.Column="0"
                    Background="#CCFFFFFF"
                    CornerRadius="10"
                    Padding="15"
                    Margin="5">
                <Border.Effect>
                    <DropShadowEffect Color="#33000000" BlurRadius="20" ShadowDepth="0"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Revenue Comparison"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="#444"
                               Margin="0,0,0,10"/>

                    <lvc:CartesianChart Grid.Row="1"
                                        VerticalAlignment="Stretch"
                                        HorizontalAlignment="Stretch">
                        <lvc:CartesianChart.Series>
                            <lvc:LineSeries Title="Current Year"
                                            Values="{Binding CurrentYearRevenue[0].Values}" />
                            <lvc:LineSeries Title="Previous Year"
                                            Values="{Binding PreviousYearRevenue[0].Values}" />
                        </lvc:CartesianChart.Series>
                    </lvc:CartesianChart>
                </Grid>
            </Border>

            <!-- Category Sales -->
            <Border Grid.Column="1"
                    Background="#CCFFFFFF"
                    CornerRadius="10"
                    Padding="15"
                    Margin="5">
                <Border.Effect>
                    <DropShadowEffect Color="#33000000" BlurRadius="20" ShadowDepth="0"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Category Sales"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="#444"
                               Margin="0,0,0,10"/>

                    <lvc:PieChart Grid.Row="1"
                                  Series="{Binding CategorySales}"
                                  LegendLocation="Right"
                                  InnerRadius="80"
                                  VerticalAlignment="Stretch"
                                  HorizontalAlignment="Stretch"/>
                </Grid>
            </Border>

        </Grid>

    </Grid>

</UserControl>
