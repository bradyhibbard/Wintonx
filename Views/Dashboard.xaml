<UserControl x:Class="Winton.Views.Dashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d"
             d:DesignWidth="1100" d:DesignHeight="700">

    <Grid Background="{DynamicResource SurfaceBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- KPI cards -->
            <RowDefinition Height="*"/>     <!-- Charts -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 0 — HEADER
        ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="20,20,20,16">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Dashboard"
                           FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryText}"/>
                <TextBlock Text="{Binding LastReportDate}"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryText}"
                           Margin="0,3,0,0"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Content="Upload Report"
                        Style="{StaticResource NavButton}"
                        Click="UploadReport_Click"
                        Padding="14,8"
                        Margin="0,0,10,0"/>
                <Button Content="Sales Floor →"
                        Style="{StaticResource AccentButton}"
                        Click="OpenSalesFloor_Click"
                        Padding="14,8"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 1 — KPI CARDS
        ═══════════════════════════════════════════════════════════ -->
        <UniformGrid Grid.Row="1" Columns="4" Margin="20,0,20,16">

            <!-- Annual Revenue -->
            <Border Background="{DynamicResource CardBackground}"
                    CornerRadius="10" Padding="18,14"
                    BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                    Margin="0,0,12,0">
                <Border.Effect>
                    <DropShadowEffect Color="#18000000" BlurRadius="12" ShadowDepth="0"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="ANNUAL REVENUE" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding AnnualRevenue}" FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource Accent}"/>
                    <TextBlock Text="{Binding AnnualDeltaText}" FontSize="11"
                               Foreground="{Binding AnnualDeltaBrush}" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- This Month Revenue -->
            <Border Background="{DynamicResource CardBackground}"
                    CornerRadius="10" Padding="18,14"
                    BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                    Margin="0,0,12,0">
                <Border.Effect>
                    <DropShadowEffect Color="#18000000" BlurRadius="12" ShadowDepth="0"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="THIS MONTH" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding MonthlyRevenue}" FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryText}"/>
                    <TextBlock Text="{Binding MonthDeltaText}" FontSize="11"
                               Foreground="{Binding MonthDeltaBrush}" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Units Sold -->
            <Border Background="{DynamicResource CardBackground}"
                    CornerRadius="10" Padding="18,14"
                    BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                    Margin="0,0,12,0">
                <Border.Effect>
                    <DropShadowEffect Color="#18000000" BlurRadius="12" ShadowDepth="0"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="UNITS SOLD · THIS MONTH" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding UnitsThisMonth}" FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryText}"/>
                    <TextBlock Text="{Binding UnitsDeltaText}" FontSize="11"
                               Foreground="{Binding UnitsDeltaBrush}" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- Active Sections -->
            <Border Background="{DynamicResource CardBackground}"
                    CornerRadius="10" Padding="18,14"
                    BorderBrush="{DynamicResource Divider}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#18000000" BlurRadius="12" ShadowDepth="0"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="ACTIVE SECTIONS" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding ActiveSections}" FontSize="28" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryText}"/>
                    <TextBlock Text="with sales this month" FontSize="11"
                               Foreground="{DynamicResource SecondaryText}" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

        </UniformGrid>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 2 — CHARTS
        ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Revenue Comparison (line chart) -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackground}"
                    CornerRadius="10" Padding="16"
                    BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                    Margin="0,0,12,0">
                <Border.Effect>
                    <DropShadowEffect Color="#18000000" BlurRadius="12" ShadowDepth="0"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Revenue Comparison"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryText}"/>
                            <TextBlock Text="Current year vs previous year, by month"
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryText}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                                Content="Expand ↗"
                                Style="{StaticResource NavButton}"
                                Padding="10,5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Click="OpenDetailedChart_Click"/>
                    </DockPanel>

                    <lvc:CartesianChart Grid.Row="1"
                                        Series="{Binding RevenueComparison}"
                                        LegendLocation="Top">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Labels="{Binding Months}"
                                      LabelsRotation="0"
                                      Separator="{x:Static lvc:DefaultAxes.CleanSeparator}"/>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis LabelFormatter="{Binding Formatter}"
                                      Separator="{x:Static lvc:DefaultAxes.CleanSeparator}"/>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </Grid>
            </Border>

            <!-- Top 5 Sections (horizontal bar) -->
            <Border Grid.Column="1"
                    Background="{DynamicResource CardBackground}"
                    CornerRadius="10" Padding="16"
                    BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                    Margin="0,0,12,0">
                <Border.Effect>
                    <DropShadowEffect Color="#18000000" BlurRadius="12" ShadowDepth="0"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Top Sections"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}"/>
                        <TextBlock Text="Revenue this month"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryText}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <lvc:CartesianChart Grid.Row="1"
                                        Series="{Binding TopSections}"
                                        LegendLocation="None">
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Labels="{Binding TopSectionLabels}"
                                      Separator="{x:Static lvc:DefaultAxes.CleanSeparator}"/>
                        </lvc:CartesianChart.AxisY>
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis LabelFormatter="{Binding Formatter}"
                                      Separator="{x:Static lvc:DefaultAxes.CleanSeparator}"/>
                        </lvc:CartesianChart.AxisX>
                    </lvc:CartesianChart>
                </Grid>
            </Border>

            <!-- Revenue by Category (horizontal bar) -->
            <Border Grid.Column="2"
                    Background="{DynamicResource CardBackground}"
                    CornerRadius="10" Padding="16"
                    BorderBrush="{DynamicResource Divider}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#18000000" BlurRadius="12" ShadowDepth="0"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Revenue by Category"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}"/>
                        <TextBlock Text="This month"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryText}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>

                    <lvc:CartesianChart Grid.Row="1"
                                        Series="{Binding CategoryRevenue}"
                                        LegendLocation="None">
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Labels="{Binding CategoryLabels}"
                                      Separator="{x:Static lvc:DefaultAxes.CleanSeparator}"/>
                        </lvc:CartesianChart.AxisY>
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis LabelFormatter="{Binding Formatter}"
                                      Separator="{x:Static lvc:DefaultAxes.CleanSeparator}"/>
                        </lvc:CartesianChart.AxisX>
                    </lvc:CartesianChart>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>
