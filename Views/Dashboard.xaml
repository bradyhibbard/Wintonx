<UserControl x:Class="Winton.Views.Dashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d"
             d:DesignWidth="900" d:DesignHeight="600">

    <Grid Background="{DynamicResource SurfaceBackground}" Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- =========================================================
             SUMMARY CARDS (Top row)
        ========================================================= -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,20">

            <!-- Annual Revenue -->
            <Border Background="{DynamicResource CardBackground}"
                    CornerRadius="10"
                    Padding="15"
                    Margin="0,0,20,0"
                    Width="250"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#22000000"
                                      BlurRadius="16"
                                      ShadowDepth="0"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Annual Revenue"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="{DynamicResource SecondaryText}"/>

                    <TextBlock Text="{Binding TotalRevenue, StringFormat=C}"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryText}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Current Month Revenue -->
            <Border Background="{DynamicResource CardBackground}"
                    CornerRadius="10"
                    Padding="15"
                    Margin="0,0,20,0"
                    Width="250"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#22000000"
                                      BlurRadius="16"
                                      ShadowDepth="0"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Current Month Revenue"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="{DynamicResource SecondaryText}"/>

                    <TextBlock Text="{Binding MonthlyRevenue, StringFormat=C}"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryText}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <!-- Total Customers -->
            <Border Background="{DynamicResource CardBackground}"
                    CornerRadius="10"
                    Padding="15"
                    Width="250"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#22000000"
                                      BlurRadius="16"
                                      ShadowDepth="0"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Total Customers"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="{DynamicResource SecondaryText}"/>

                    <TextBlock Text="{Binding TotalCustomers}"
                               FontSize="26"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryText}"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

        </StackPanel>

        <!-- =========================================================
             CHARTS (Bottom row)
        ========================================================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Revenue Comparison -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackground}"
                    CornerRadius="10"
                    Padding="15"
                    Margin="0,0,20,0"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1">

                <Border.Effect>
                    <DropShadowEffect Color="#22000000"
                                      BlurRadius="16"
                                      ShadowDepth="0"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Revenue Comparison"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="{DynamicResource SecondaryText}"
                               Margin="0,0,0,10"/>

                    <lvc:CartesianChart Grid.Row="1">
                        <lvc:CartesianChart.Series>
                            <lvc:LineSeries Title="Current Year"
                                            Values="{Binding CurrentYearRevenue[0].Values}"/>
                            <lvc:LineSeries Title="Previous Year"
                                            Values="{Binding PreviousYearRevenue[0].Values}"/>
                        </lvc:CartesianChart.Series>
                    </lvc:CartesianChart>
                </Grid>
            </Border>

            <!-- Category Sales -->
            <Border Grid.Column="1"
                    Background="{DynamicResource CardBackground}"
                    CornerRadius="10"
                    Padding="15"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#22000000"
                                      BlurRadius="16"
                                      ShadowDepth="0"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Category Sales"
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="{DynamicResource SecondaryText}"
                               Margin="0,0,0,10"/>

                    <lvc:PieChart Grid.Row="1"
                                  Series="{Binding CategorySales}"
                                  LegendLocation="Right"
                                  InnerRadius="80"/>
                </Grid>
            </Border>

        </Grid>

    </Grid>
</UserControl>
