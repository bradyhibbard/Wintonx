<UserControl x:Class="Winton.Views.Dashboard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             d:DesignHeight="600" d:DesignWidth="800">

	<Grid>
		<!-- Background -->
		<Grid.Background>
            <ImageBrush ImageSource="/Assets/Couch.jpg" 
                        Stretch="UniformToFill" Opacity="0.3"/>
		</Grid.Background>

		<!-- Define Rows (1/3 for summary, 2/3 for charts) -->
		<Grid.RowDefinitions>
			<RowDefinition Height="1*" />
			<!-- Takes 1/3 of the available height -->
			<RowDefinition Height="2*" />
			<!-- Takes 2/3 of the available height -->
		</Grid.RowDefinitions>

		<!-- Summary Boxes (Expands Vertically) -->
		<Grid Grid.Row="0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<Border Background="LightGray" Padding="10" Margin="5" Grid.Column="0" CornerRadius="5">
				<StackPanel VerticalAlignment="Stretch">
					<TextBlock Text="Annual Revenue" FontWeight="Bold"/>
					<TextBlock Text="{Binding TotalRevenue, StringFormat=C}" 
                               FontSize="20" Height="Auto" 
                               TextAlignment="Center" Margin="0,10,0,0"/>
				</StackPanel>
			</Border>

			<Border Background="LightGray" Padding="10" Margin="5" Grid.Column="1" CornerRadius="5">
				<StackPanel VerticalAlignment="Stretch">
					<TextBlock Text="Current Month Revenue" FontWeight="Bold"/>
					<TextBlock Text="{Binding MonthlyRevenue, StringFormat=C}" 
                               FontSize="20" Height="Auto" 
                               TextAlignment="Center" Margin="0,10,0,0"/>
				</StackPanel>
			</Border>

			<Border Background="LightGray" Padding="10" Margin="5" Grid.Column="2" CornerRadius="5">
				<StackPanel VerticalAlignment="Stretch">
					<TextBlock Text="Total Customers" FontWeight="Bold"/>
					<TextBlock Text="{Binding TotalCustomers}" 
                               FontSize="20" Height="Auto" 
                               TextAlignment="Center" Margin="0,10,0,0"/>
				</StackPanel>
			</Border>
		</Grid>

		<!-- Charts Section (Takes 2/3 of Height) -->
		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>

			<Border Grid.Column="0" Background="LightGray" Padding="10" Margin="5" CornerRadius="5">
				<Grid>
					<!-- Two rows: one for the title, one for the chart -->
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<!-- For the TextBlock -->
						<RowDefinition Height="*"/>
						<!-- For the chart to fill remaining space -->
					</Grid.RowDefinitions>

					<TextBlock Text="Revenue Comparison" 
                   FontWeight="Bold" FontSize="13"
                   Grid.Row="0" Margin="0,0,0,5"/>

					<lvc:CartesianChart Grid.Row="1"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Stretch">
						<lvc:CartesianChart.Series>
							<lvc:LineSeries Title="Current Year" 
                                Values="{Binding CurrentYearRevenue[0].Values}" />
							<lvc:LineSeries Title="Previous Year" 
                                Values="{Binding PreviousYearRevenue[0].Values}" />
						</lvc:CartesianChart.Series>
					</lvc:CartesianChart>
				</Grid>
			</Border>

			<Border Grid.Column="1" Background="LightGray" Padding="10" Margin="5" CornerRadius="5">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<TextBlock Text="Category Sales" 
                   FontWeight="Bold" FontSize="13"
                   Grid.Row="0" Margin="0,0,0,5"/>

					<lvc:PieChart Grid.Row="1"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch"
                      Series="{Binding CategorySales}" 
                      LegendLocation="Right"
					  InnerRadius="80"/>
				</Grid>
			</Border>

		</Grid>
	</Grid>
</UserControl>
