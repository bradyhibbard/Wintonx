<UserControl x:Class="Winton.Views.FilterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="250">
	<Border Background="white" Padding="10">
		<StackPanel>
			<TextBlock Text="Filter Options" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

			<TextBlock Text="Vendor:" Foreground="Black"/>
			<ComboBox x:Name="VendorComboBox" Margin="0,5,0,10" SelectionChanged="VendorComboBox_SelectionChanged"/>

			<TextBlock Text="Category:" Foreground="Black"/>
			<ComboBox x:Name="CategoryComboBox" Margin="0,5,0,10" SelectionChanged="CategoryComboBox_SelectionChanged"/>

			<TextBlock Text="Group:" Foreground="Black"/>
			<ComboBox x:Name="GroupComboBox" Margin="0,5,0,10" SelectionChanged="GroupComboBox_SelectionChanged"/>

			<TextBlock Text="Start Date:" Foreground="Black"/>
			<DatePicker x:Name="StartDatePicker" Margin="0,5,0,10"/>

			<TextBlock Text="End Date:" Foreground="Black"/>
			<DatePicker x:Name="EndDatePicker" Margin="0,5,0,10"/>

			<Button x:Name="ApplyFilterButton" Content="Apply Filters" Margin="0,10,0,0"/>
			<Button x:Name="ResetFilterButton" Content="Reset Filters" Margin="0,5,0,0"/>
		</StackPanel>
	</Border>
</UserControl>
