<UserControl x:Class="Winton.Views.SectionDetail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Winton.Views"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:Winton.Converters"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900"
             Background="#AA1E1E1E">

    <UserControl.Resources>
        <conv:MultiplyConverter x:Key="MultiplyConverter"/>
    </UserControl.Resources>

    <Grid>

        <!-- MODAL WINDOW -->
        <Border Background="#2D2D30"
                CornerRadius="10"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Width="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ActualWidth, Converter={StaticResource MultiplyConverter}, ConverterParameter=0.75}"
                Height="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=ActualHeight, Converter={StaticResource MultiplyConverter}, ConverterParameter=0.65}">

            <!-- ⭐ NEW: SCROLLVIEWER WRAPS THE ENTIRE CONTENT ⭐ -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Header -->
                        <RowDefinition Height="Auto"/>
                        <!-- Date range -->
                        <RowDefinition Height="Auto"/>
                        <!-- Summary cards -->
                        <RowDefinition Height="Auto"/>
                        <!-- Charts -->
                        <RowDefinition Height="Auto"/>
                        <!-- Table -->
                    </Grid.RowDefinitions>

                    <!-- HEADER -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="{Binding SectionName}"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   DockPanel.Dock="Left"/>
                        <Button Content="✕"
                                Width="40" Height="40"
                                HorizontalAlignment="Right"
                                Click="Close_Click"
                                Background="Transparent"
                                Foreground="White"
                                BorderBrush="Transparent"/>
                    </DockPanel>

                    <!-- DATE RANGE -->
                    <StackPanel Orientation="Horizontal"
                                Grid.Row="1"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,10">
                        <TextBlock Text="{Binding StartDate, StringFormat='{}{0:MMM dd, yyyy}'}"
                                   Foreground="LightGray" FontSize="14"/>
                        <TextBlock Text=" — " Foreground="LightGray" FontSize="14"/>
                        <TextBlock Text="{Binding EndDate, StringFormat='{}{0:MMM dd, yyyy}'}"
                                   Foreground="LightGray" FontSize="14"/>
                    </StackPanel>

                    <!-- SUMMARY CARDS -->
                    <UniformGrid Grid.Row="2" Columns="3" Margin="0,10,0,20">
                        <Border Background="#3A3A3C" CornerRadius="8" Padding="10" Margin="5">
                            <StackPanel>
                                <TextBlock Text="Total Revenue" Foreground="LightGray" FontSize="12"/>
                                <TextBlock Text="{Binding TotalRevenue, StringFormat='{}{0:C}'}"
                                           Foreground="White" FontSize="22" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#3A3A3C" CornerRadius="8" Padding="10" Margin="5">
                            <StackPanel>
                                <TextBlock Text="Quantity Sold" Foreground="LightGray" FontSize="12"/>
                                <TextBlock Text="{Binding TotalQuantitySold}"
                                           Foreground="White" FontSize="22" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#3A3A3C" CornerRadius="8" Padding="10" Margin="5">
                            <StackPanel>
                                <TextBlock Text="Top Product" Foreground="LightGray" FontSize="12"/>
                                <TextBlock Text="{Binding TopProductName}"
                                           Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TopProductRevenue, StringFormat='{}{0:C}'}"
                                           Foreground="White" FontSize="14"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- CHARTS -->
                    <Grid Grid.Row="3" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#3A3A3C" CornerRadius="8" Margin="5" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Revenue Trend (Daily)"
                                           Foreground="White" FontSize="16"
                                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <lvc:CartesianChart Series="{Binding DailyTrendline}" LegendLocation="Right">
                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis Title="Date" LabelsRotation="15"/>
                                    </lvc:CartesianChart.AxisX>
                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis Title="Revenue ($)"/>
                                    </lvc:CartesianChart.AxisY>
                                </lvc:CartesianChart>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#3A3A3C" CornerRadius="8" Margin="5" Padding="10">
                            <StackPanel>
                                <TextBlock Text="Top 5 Products"
                                           Foreground="White" FontSize="16"
                                           FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <lvc:CartesianChart Series="{Binding TopProductsBarChart}" LegendLocation="Right">
                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis Title="Revenue ($)"/>
                                    </lvc:CartesianChart.AxisY>
                                </lvc:CartesianChart>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- PRODUCT TABLE -->
                    <Border Grid.Row="4" Background="#3A3A3C" CornerRadius="8" Padding="10">
                        <DataGrid ItemsSource="{Binding ProductBreakdown}"
                                  AutoGenerateColumns="False"
                                  Foreground="White"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  Background="Transparent"
                                  BorderBrush="Transparent"
                                  RowBackground="#2D2D30"
                                  AlternatingRowBackground="#39393B">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Item #" Binding="{Binding ItemNumber}" Width="*" />
                                <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="2*" />
                                <DataGridTextColumn Header="Qty Sold" Binding="{Binding QuantitySold}" Width="*" />
                                <DataGridTextColumn Header="Revenue" Binding="{Binding Revenue, StringFormat='{}{0:C}'}" Width="*" />
                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="*" />
                                <DataGridTextColumn Header="Date Placed" Binding="{Binding DatePlaced, StringFormat='{}{0:MMM dd, yyyy}'}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                </Grid>
            </ScrollViewer>
        </Border>

    </Grid>
</UserControl>
