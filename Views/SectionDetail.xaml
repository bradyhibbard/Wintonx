<UserControl x:Class="Winton.Views.SectionDetail"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:conv="clr-namespace:Winton.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="#88000000"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <conv:MultiplyConverter x:Key="MultiplyConverter" />
    </UserControl.Resources>

    <!-- OVERLAY BACKGROUND -->
    <Grid Background="#22000000">

        <!-- FLOATING LIGHT-THEME MODAL -->
        <Border Background="{DynamicResource CardBackground}"
                CornerRadius="12"
                Padding="20"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="1"
                Width="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, 
                        Path=ActualWidth, Converter={StaticResource MultiplyConverter}, ConverterParameter=0.85}"
                Height="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, 
                         Path=ActualHeight, Converter={StaticResource MultiplyConverter}, ConverterParameter=0.80}">

            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                  ShadowDepth="0"
                                  Color="#88000000"/>
            </Border.Effect>

            <!-- MAIN SCROLL CONTAINER -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Header -->
                        <RowDefinition Height="Auto"/>
                        <!-- Date range -->
                        <RowDefinition Height="Auto"/>
                        <!-- Summary cards -->
                        <RowDefinition Height="Auto"/>
                        <!-- Charts -->
                        <RowDefinition Height="Auto"/>
                        <!-- Table -->
                    </Grid.RowDefinitions>

                    <!-- ======================================================
                         HEADER
                    ====================================================== -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="{Binding SectionName}"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   DockPanel.Dock="Left"/>

                        <Button Content="✕"
                                Width="36" Height="36"
                                HorizontalAlignment="Right"
                                Click="Close_Click"
                                Background="Transparent"
                                Foreground="{DynamicResource PrimaryText}"
                                BorderBrush="Transparent"
                                FontSize="16"
                                Cursor="Hand"/>
                    </DockPanel>

                    <!-- ======================================================
                         DATE RANGE
                    ====================================================== -->
                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Margin="0,0,0,0">

                        <TextBlock Text="{Binding StartDate, StringFormat='{}{0:MMM dd, yyyy}'}"
                                   Foreground="{DynamicResource SecondaryText}"
                                   FontSize="14"/>

                        <TextBlock Text=" — "
                                   Foreground="{DynamicResource SecondaryText}"
                                   FontSize="14"/>

                        <TextBlock Text="{Binding EndDate, StringFormat='{}{0:MMM dd, yyyy}'}"
                                   Foreground="{DynamicResource SecondaryText}"
                                   FontSize="14"/>
                    </StackPanel>

                    <!-- ======================================================
                         SUMMARY CARDS
                    ====================================================== -->
                    <UniformGrid Grid.Row="2"
                                 Columns="3"
                                 Margin="0,0,0,0">

                        <Border Background="{DynamicResource SurfaceBackground}"
                                CornerRadius="8"
                                BorderBrush="{DynamicResource Divider}"
                                BorderThickness="1"
                                Padding="16"
                                Margin="6">

                            <StackPanel>
                                <TextBlock Text="Total Revenue"
                                           Foreground="{DynamicResource SecondaryText}"
                                           FontSize="13"/>
                                <TextBlock Text="{Binding TotalRevenue, StringFormat='{}{0:C}'}"
                                           FontSize="22"
                                           Foreground="{DynamicResource PrimaryText}"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource SurfaceBackground}"
                                CornerRadius="8"
                                BorderBrush="{DynamicResource Divider}"
                                BorderThickness="1"
                                Padding="16"
                                Margin="6">

                            <StackPanel>
                                <TextBlock Text="Quantity Sold"
                                           Foreground="{DynamicResource SecondaryText}"
                                           FontSize="13"/>
                                <TextBlock Text="{Binding TotalQuantitySold}"
                                           FontSize="22"
                                           Foreground="{DynamicResource PrimaryText}"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource SurfaceBackground}"
                                CornerRadius="8"
                                BorderBrush="{DynamicResource Divider}"
                                BorderThickness="1"
                                Padding="16"
                                Margin="6">

                            <StackPanel>
                                <TextBlock Text="Top Product"
                                           Foreground="{DynamicResource SecondaryText}"
                                           FontSize="13"/>
                                <TextBlock Text="{Binding TopProductName}"
                                           FontSize="20"
                                           Foreground="{DynamicResource PrimaryText}"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding TopProductRevenue, StringFormat='{}{0:C}'}"
                                           Foreground="{DynamicResource PrimaryText}"
                                           FontSize="14"/>
                            </StackPanel>
                        </Border>

                    </UniformGrid>

                    <!-- ======================================================
                         CHARTS
                    ====================================================== -->
                    <Grid Grid.Row="3" Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- DAILY TREND -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource SurfaceBackground}"
                                CornerRadius="8"
                                BorderBrush="{DynamicResource Divider}"
                                BorderThickness="1"
                                Margin="6"
                                Padding="16">

                            <StackPanel>
                                <TextBlock Text="Revenue Trend (Daily)"
                                           Foreground="{DynamicResource PrimaryText}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>

                                <lvc:CartesianChart Series="{Binding DailyTrendline}" LegendLocation="Right">
                                    <lvc:CartesianChart.AxisX>
                                        <lvc:Axis Title="Date" LabelsRotation="15"/>
                                    </lvc:CartesianChart.AxisX>
                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis Title="Revenue ($)"/>
                                    </lvc:CartesianChart.AxisY>
                                </lvc:CartesianChart>
                            </StackPanel>
                        </Border>

                        <!-- TOP 5 BAR -->
                        <Border Grid.Column="1"
                                Background="{DynamicResource SurfaceBackground}"
                                CornerRadius="8"
                                BorderBrush="{DynamicResource Divider}"
                                BorderThickness="1"
                                Margin="6"
                                Padding="16">

                            <StackPanel>
                                <TextBlock Text="Top 5 Products"
                                           Foreground="{DynamicResource PrimaryText}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>

                                <lvc:CartesianChart Series="{Binding TopProductsBarChart}" LegendLocation="Right">
                                    <lvc:CartesianChart.AxisY>
                                        <lvc:Axis Title="Revenue ($)"/>
                                    </lvc:CartesianChart.AxisY>
                                </lvc:CartesianChart>
                            </StackPanel>

                        </Border>
                    </Grid>

                    <!-- ======================================================
                         PRODUCT TABLE
                    ====================================================== -->
                    <Border Grid.Row="4"
                            Background="{DynamicResource SurfaceBackground}"
                            CornerRadius="8"
                            BorderBrush="{DynamicResource Divider}"
                            BorderThickness="1"
                            Padding="16">

                        <DataGrid ItemsSource="{Binding ProductBreakdown}"
                                  AutoGenerateColumns="False"
                                  GridLinesVisibility="None"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  Background="{DynamicResource SurfaceBackground}"
                                  BorderBrush="{DynamicResource Divider}"
                                  Foreground="{DynamicResource PrimaryText}"
                                  RowBackground="White"
                                  AlternatingRowBackground="#F8F8F8">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Item #" Binding="{Binding ItemNumber}" Width="*" />
                                <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="2*" />
                                <DataGridTextColumn Header="Qty Sold" Binding="{Binding QuantitySold}" Width="*" />
                                <DataGridTextColumn Header="Revenue" Binding="{Binding Revenue, StringFormat='{}{0:C}'}" Width="*" />
                                <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="*" />
                                <DataGridTextColumn Header="Date Placed" Binding="{Binding DatePlaced, StringFormat='{}{0:MMM dd, yyyy}'}" Width="*" />
                            </DataGrid.Columns>

                        </DataGrid>
                    </Border>

                </Grid>
            </ScrollViewer>

        </Border>

    </Grid>
</UserControl>
