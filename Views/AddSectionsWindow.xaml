<Window x:Class="Winton.Views.AddSectionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Section" Height="600" Width="250"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#333">
	<Grid>
		<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
			<TextBlock Text="INSERT" HorizontalAlignment="Center" FontSize="16" Foreground="White" FontWeight="Bold" Margin="0,5"/>

			<!-- Shape Selection -->
			<Button Content="Square" Background="Transparent" Foreground="White" Click="AddSquare_Click" Margin="5" Width="200"/>
			<Button Content="Circle" Background="Transparent" Foreground="White" Click="AddCircle_Click" Margin="5" Width="200"/>
			<Button Content="Triangle" Background="Transparent" Foreground="White" Click="AddTriangle_Click" Margin="5" Width="200"/>
			<Button Content="Cross" Background="Transparent" Foreground="White" Click="AddCross_Click" Margin="5" Width="200"/>
			<Button Content="Draw Custom" Background="Transparent" Foreground="White" Click="DrawCustomSection_Click" Margin="5" Width="200"/>


			<!-- Size Controls -->
			<TextBlock Text="Width" HorizontalAlignment="Center" FontSize="12" Foreground="White" FontWeight="Bold" Margin="0,5,0,2"/>
			<Slider x:Name="WidthSlider" Minimum="10" Maximum="200" ValueChanged="WidthSlider_ValueChanged" Width="200"/>

			<TextBlock Text="Height" HorizontalAlignment="Center" FontSize="12" Foreground="White" FontWeight="Bold" Margin="0,5,0,2"/>
			<Slider x:Name="HeightSlider" Minimum="10" Maximum="200" ValueChanged="HeightSlider_ValueChanged" Width="200"/>

			<!-- Rotation Controls -->
			<TextBlock Text="Rotation" HorizontalAlignment="Center" FontSize="12" Foreground="White" FontWeight="Bold" Margin="0,5,0,2"/>
			<Slider x:Name="RotationSlider" Minimum="0" Maximum="360" ValueChanged="RotationSlider_ValueChanged" Width="200"/>
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
				<Button Content="↺ -90°" Background="Transparent" Foreground="White" Click="RotateLeft_Click" Width="90"/>
				<Button Content="↻ +90°" Background="Transparent" Foreground="White" Click="RotateRight_Click" Width="90" Margin="5,0,0,0"/>
			</StackPanel>

			<!-- Shape Preview -->
			<Border BorderThickness="1" BorderBrush="White" Height="100" Width="100" HorizontalAlignment="Center" Margin="10">
				<Canvas x:Name="PreviewCanvas" Background="LightGray"/>
			</Border>

			<!-- Action Buttons -->
			<Button Content="Apply" Click="ApplyShape_Click" Margin="0,5,0,2" Width="200" Background="White" Foreground="Black"/>
			<Button Content="Close" Click="CloseWindow_Click" Margin="10,5,10,5" Width="200" Background="White" Foreground="Red"/>
		</StackPanel>
	</Grid>
</Window>
