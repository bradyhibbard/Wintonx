<Window x:Class="Winton.Views.AddSectionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Section" Height="600" Width="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#333">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
            <TextBlock Text="INSERT" HorizontalAlignment="Center" FontSize="16" Foreground="White" FontWeight="Bold" Margin="0,5"/>

            <!-- Shape Selection -->
            <Button Content="Square" Background="Transparent" Foreground="White" Click="AddSquare_Click" Margin="5" Width="200"/>
            <Button Content="Circle" Background="Transparent" Foreground="White" Click="AddCircle_Click" Margin="5" Width="200"/>
            <Button Content="Triangle" Background="Transparent" Foreground="White" Click="AddTriangle_Click" Margin="5" Width="200"/>

            <!-- Dimension + Rotation Controls -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,10">
                <!-- Width -->
                <StackPanel Margin="5" Width="80">
                    <TextBlock Text="Width" HorizontalAlignment="Center" FontSize="12" Foreground="White" FontWeight="Bold"/>
                    <TextBox x:Name="WidthBox"
                             Text="50"
                             HorizontalContentAlignment="Center"
                             PreviewTextInput="NumericOnly_PreviewTextInput"
                             LostFocus="WidthBox_LostFocus"/>
                </StackPanel>

                <!-- Height -->
                <StackPanel Margin="5" Width="80">
                    <TextBlock Text="Height" HorizontalAlignment="Center" FontSize="12" Foreground="White" FontWeight="Bold"/>
                    <TextBox x:Name="HeightBox"
                             Text="50"
                             HorizontalContentAlignment="Center"
                             PreviewTextInput="NumericOnly_PreviewTextInput"
                             LostFocus="HeightBox_LostFocus"/>
                </StackPanel>

                <!-- Rotation -->
                <StackPanel Margin="5" Width="80">
                    <TextBlock Text="Rotation" HorizontalAlignment="Center" FontSize="12" Foreground="White" FontWeight="Bold"/>
                    <TextBox x:Name="RotationBox"
                             Text="0"
                             HorizontalContentAlignment="Center"
                             PreviewTextInput="NumericOnly_PreviewTextInput"
                             LostFocus="RotationBox_LostFocus"/>
                </StackPanel>
            </StackPanel>

            <!-- Shape Preview -->
            <Border BorderThickness="1" BorderBrush="White" Height="100" Width="100" HorizontalAlignment="Center" Margin="10">
                <Canvas x:Name="PreviewCanvas" Background="LightGray"/>
            </Border>

            <!-- Action Buttons -->
            <Button Content="Apply" Click="ApplyShape_Click" Margin="0,5,0,2" Width="200" Background="White" Foreground="Black"/>
            <Button Content="Close" Click="CloseWindow_Click" Margin="10,5,10,5" Width="200" Background="White" Foreground="Red"/>
        </StackPanel>
    </Grid>
</Window>
