<UserControl x:Class="Winton.Views.LiveSalesFloor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">

    <Grid Background="{DynamicResource SurfaceBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================================================== TOOLBAR ===================================================== -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackground}"
                CornerRadius="8"
                Padding="8"
                Margin="15"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#44000000"
                                  BlurRadius="12"
                                  ShadowDepth="2"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource NavButton}"
                        Content="Add Products"
                        Click="AddProducts_Click"
                        Padding="12,6"
                        Margin="0,0,10,0"/>

                <Button Style="{StaticResource NavButton}"
                        Content="Filters"
                        Click="Filters_Click"
                        Padding="12,6"/>
            </StackPanel>
        </Border>

        <!-- ===================================================== MAIN GRID ===================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FilterPanelColumn" Width="0"/>
                <ColumnDefinition x:Name="ProductPanelColumn" Width="0"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===================================================== FILTER PANEL ===================================================== -->
            <Border Grid.Column="0"
                    x:Name="FilterPanel"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="0,0,1,0"
                    Padding="24"
                    Visibility="Collapsed">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0" MaxWidth="260">

                        <TextBlock Text="Filters"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   Margin="0,0,0,16"/>

                        <TextBlock Text="Vendor"
                                   Foreground="{DynamicResource SecondaryText}"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="VendorTextBox"
                                 Margin="0,0,0,16"
                                 TextChanged="VendorTextBox_TextChanged"/>

                        <TextBlock Text="Category"
                                   Foreground="{DynamicResource SecondaryText}"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="CategoryTextBox"
                                 Margin="0,0,0,16"
                                 TextChanged="CategoryTextBox_TextChanged"/>

                        <TextBlock Text="Group"
                                   Foreground="{DynamicResource SecondaryText}"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="GroupTextBox"
                                 Margin="0,0,0,16"
                                 TextChanged="GroupTextBox_TextChanged"/>

                        <TextBlock Text="Product"
                                   Foreground="{DynamicResource SecondaryText}"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="ProductTextBox"
                                 Margin="0,0,0,16"
                                 TextChanged="ProductTextBox_TextChanged"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===================================================== PRODUCT PANEL ===================================================== -->
            <Border Grid.Column="1"
                    x:Name="ProductPanel"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1,0,0,0"
                    Padding="24"
                    Visibility="Collapsed">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">

                        <TextBlock Text="Section ID"
                                   Foreground="{DynamicResource SecondaryText}"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="SectionIdTextBox"
                                 Margin="0,0,0,12"
                                 TextChanged="SectionIdTextBox_TextChanged"/>

                        <TextBlock Text="Search Products"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   Margin="0,10,0,6"/>

                        <TextBlock Text="Vendor"
                                   Foreground="{DynamicResource SecondaryText}"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="ProductVendorTextBox"
                                 Margin="0,4,0,12"
                                 TextChanged="ProductVendorTextBox_TextChanged"/>

                        <TextBlock Text="Category"
                                   Foreground="{DynamicResource SecondaryText}"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="ProductCategoryTextBox"
                                 Margin="0,4,0,12"
                                 TextChanged="ProductCategoryTextBox_TextChanged"/>

                        <TextBlock Text="Group"
                                   Foreground="{DynamicResource SecondaryText}"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="ProductGroupTextBox"
                                 Margin="0,4,0,12"
                                 TextChanged="ProductGroupTextBox_TextChanged"/>

                        <TextBlock Text="Product"
                                   Foreground="{DynamicResource SecondaryText}"
                                   Margin="0,0,0,6"/>
                        <TextBox x:Name="AddProductTextBox"
                                 Margin="0,4,0,12"
                                 TextChanged="ProductProductTextBox_TextChanged"/>

                        <Button Content="View Section Archive"
                                Style="{StaticResource NavButton}"
                                Margin="0,6,0,12"
                                Click="ViewSectionArchive_Click"/>

                        <CheckBox x:Name="SelectAllCheckBox"
                                  Content="Select All"
                                  Margin="0,6,0,6"
                                  Checked="SelectAllCheckBox_Checked"
                                  Unchecked="SelectAllCheckBox_Unchecked"/>

                        <ListBox x:Name="FilteredProductsListBox"
                                 Height="250"
                                 Margin="0,0,0,12"
                                 SelectionMode="Multiple"/>

                        <Button Content="Add Products"
                                Style="{StaticResource NavButton}"
                                Margin="0,6,0,12"
                                Click="AddProductButton_Click"/>

                        <TextBlock Text="Added Products"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   Margin="0,12,0,6"/>

                        <ListBox x:Name="AddedProductsListBox"
                                 Height="250"
                                 Margin="0,0,0,12"
                                 SelectionChanged="AddedProductsListBox_SelectionChanged"/>

                        <TextBlock Text="Date Added"
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryText}"
                                   Margin="0,10,0,4"/>

                        <DatePicker x:Name="DateAddedPicker"
                                    Margin="0,0,0,12"
                                    SelectedDateChanged="DateAddedPicker_SelectedDateChanged"/>

                        <Button Content="Remove Selected"
                                Style="{StaticResource NavButton}"
                                Margin="0,6,0,0"
                                Click="RemoveProductButton_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ===================================================== FLOOR CANVAS + OVERLAYS ===================================================== -->
            <Grid Grid.Column="2"
                  Background="{DynamicResource SurfaceBackground}">

                <!-- 🔥 BOTH CANVASES INSIDE SAME VIEWBOX = CLICKABLE REVENUE OVERLAYS -->
                <Viewbox Stretch="Uniform">
                    <Grid Width="1200" Height="600">

                        <!-- Base Live Canvas -->
                        <Canvas x:Name="LiveFloorCanvas"
                                Background="{DynamicResource SurfaceBackground}"
                                Width="1200"
                                Height="600"/>

                        <!-- Revenue Overlay Canvas (Click-through except borders) -->
                        <Canvas x:Name="RevenueOverlayCanvas"
                                Width="1200"
                                Height="600"
                                Background="Transparent"
                                IsHitTestVisible="False"
                                Panel.ZIndex="20"/>

                    </Grid>
                </Viewbox>

                <!-- Section Detail Overlay -->
                <Grid x:Name="SectionDetailOverlay"
                      Background="Transparent"
                      Visibility="Collapsed"
                      IsHitTestVisible="False"
                      Panel.ZIndex="55"/>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
