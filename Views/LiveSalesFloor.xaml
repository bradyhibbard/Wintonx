<UserControl x:Class="Winton.Views.LiveSalesFloor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid Background="{DynamicResource SurfaceBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- =====================================================
             FLOATING TOOLBAR
        ===================================================== -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackground}"
                CornerRadius="8"
                Padding="8"
                Margin="15"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="#44000000"
                                  BlurRadius="12"
                                  ShadowDepth="2"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource NavButton}"
                        Content="Add Products"
                        Click="AddProducts_Click"
                        Padding="12,6"
                        Margin="0,0,10,0"/>

                <Button Style="{StaticResource NavButton}"
                        Content="Filters"
                        Click="Filters_Click"
                        Padding="12,6"/>
            </StackPanel>
        </Border>

        <!-- =====================================================
             MAIN CONTENT: PANELS + CANVAS
        ===================================================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FilterPanelColumn" Width="0"/>
                <ColumnDefinition x:Name="ProductPanelColumn" Width="0"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- =====================================================
                 FILTER PANEL (Left)
            ===================================================== -->
            <Border Grid.Column="0"
                    x:Name="FilterPanel"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="0,0,1,0"
                    Padding="16"
                    Visibility="Collapsed">
                <StackPanel>

                    <TextBlock Text="Filters"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryText}"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Vendor" Foreground="{DynamicResource SecondaryText}"/>
                    <TextBox x:Name="VendorTextBox"
                             Margin="0,4,0,10"
                             TextChanged="VendorTextBox_TextChanged"/>

                    <TextBlock Text="Category" Foreground="{DynamicResource SecondaryText}"/>
                    <TextBox x:Name="CategoryTextBox"
                             Margin="0,4,0,10"
                             TextChanged="CategoryTextBox_TextChanged"/>

                    <TextBlock Text="Group" Foreground="{DynamicResource SecondaryText}"/>
                    <TextBox x:Name="GroupTextBox"
                             Margin="0,4,0,10"
                             TextChanged="GroupTextBox_TextChanged"/>

                    <TextBlock Text="Product" Foreground="{DynamicResource SecondaryText}"/>
                    <TextBox x:Name="ProductTextBox"
                             Margin="0,4,0,10"
                             TextChanged="ProductTextBox_TextChanged"/>

                </StackPanel>
            </Border>

            <!-- =====================================================
                 PRODUCT PANEL (Right)
            ===================================================== -->
            <Border Grid.Column="1"
                    x:Name="ProductPanel"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1,0,0,0"
                    Padding="16"
                    Visibility="Collapsed">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT SIDE: Searching -->
                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Section ID"
                                   Foreground="{DynamicResource SecondaryText}"
                                   Margin="0,0,0,4"/>
                        <TextBox x:Name="SectionIdTextBox"
                                 Margin="0,0,0,10"
                                 TextChanged="SectionIdTextBox_TextChanged"/>

                        <TextBlock Text="Search Products"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,10,0,10"
                                   Foreground="{DynamicResource PrimaryText}"/>

                        <TextBlock Text="Vendor" Foreground="{DynamicResource SecondaryText}"/>
                        <TextBox x:Name="ProductVendorTextBox"
                                 Margin="0,4,0,10"
                                 TextChanged="ProductVendorTextBox_TextChanged"/>

                        <TextBlock Text="Category" Foreground="{DynamicResource SecondaryText}"/>
                        <TextBox x:Name="ProductCategoryTextBox"
                                 Margin="0,4,0,10"
                                 TextChanged="ProductCategoryTextBox_TextChanged"/>

                        <TextBlock Text="Group" Foreground="{DynamicResource SecondaryText}"/>
                        <TextBox x:Name="ProductGroupTextBox"
                                 Margin="0,4,0,10"
                                 TextChanged="ProductGroupTextBox_TextChanged"/>

                        <TextBlock Text="Product" Foreground="{DynamicResource SecondaryText}"/>
                        <TextBox x:Name="AddProductTextBox"
                                 Margin="0,4,0,10"
                                 TextChanged="ProductProductTextBox_TextChanged"/>

                        <Button Content="View Section Archive"
                                Click="ViewSectionArchive_Click"
                                Margin="0,10,0,0"/>

                    </StackPanel>

                    <!-- RIGHT SIDE -->
                    <ScrollViewer Grid.Column="1"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <CheckBox x:Name="SelectAllCheckBox"
                                      Content="Select All"
                                      Margin="0,0,0,10"
                                      Checked="SelectAllCheckBox_Checked"
                                      Unchecked="SelectAllCheckBox_Unchecked"/>

                            <ListBox x:Name="FilteredProductsListBox"
                                     Height="250"
                                     SelectionMode="Multiple"
                                     Margin="0,0,0,10"/>

                            <Button Content="Add Products"
                                    Click="AddProductButton_Click"
                                    Margin="0,0,0,10"/>

                            <TextBlock Text="Added Products"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Margin="0,10,0,10"/>

                            <ListBox x:Name="AddedProductsListBox"
                                     Height="250"
                                     SelectionMode="Single"
                                     Margin="0,0,0,10"
                                     SelectionChanged="AddedProductsListBox_SelectionChanged"/>

                            <TextBlock Text="Date Added"
                                       FontSize="12"
                                       Margin="0,10,0,4"/>

                            <DatePicker x:Name="DateAddedPicker"
                                        Margin="0,0,0,10"
                                        SelectedDateChanged="DateAddedPicker_SelectedDateChanged"/>

                            <Button Content="Remove Selected"
                                    Click="RemoveProductButton_Click"/>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- =====================================================
                 CANVAS AREA
            ===================================================== -->
            <Grid Grid.Column="2" Background="{DynamicResource SurfaceBackground}">

                <Viewbox Stretch="Uniform">
                    <Canvas x:Name="LiveFloorCanvas"
                            Background="{DynamicResource SurfaceBackground}"
                            Width="1200"
                            Height="600"/>
                </Viewbox>

                <Canvas x:Name="RevenueOverlayCanvas"
                        Background="Transparent"
                        IsHitTestVisible="True"
                        Panel.ZIndex="20"/>

                <Grid x:Name="SectionDetailOverlay"
                      Background="#AA000000"
                      Visibility="Collapsed"
                      Panel.ZIndex="50"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
