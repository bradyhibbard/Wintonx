<UserControl x:Class="Winton.Views.LiveSalesFloor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1100">

    <Grid Background="{DynamicResource SurfaceBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- KPI bar -->
            <RowDefinition Height="Auto"/>  <!-- Filter toolbar -->
            <RowDefinition Height="*"/>     <!-- Canvas + right drawer -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 0 — KPI BAR
        ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="16,12,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Revenue -->
            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackground}"
                    CornerRadius="8" Padding="16,12"
                    BorderBrush="{DynamicResource Divider}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="REVENUE" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,3"/>
                    <TextBlock x:Name="KpiRevenue" Text="—" FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource Accent}"/>
                    <TextBlock x:Name="KpiRevenuePeriod" Text="This Month" FontSize="11"
                               Foreground="{DynamicResource SecondaryText}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Units Sold -->
            <Border Grid.Column="2"
                    Background="{DynamicResource CardBackground}"
                    CornerRadius="8" Padding="16,12"
                    BorderBrush="{DynamicResource Divider}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="UNITS SOLD" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,3"/>
                    <TextBlock x:Name="KpiUnits" Text="—" FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryText}"/>
                    <TextBlock x:Name="KpiUnitsPeriod" Text="This Month" FontSize="11"
                               Foreground="{DynamicResource SecondaryText}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>

            <!-- Active Sections -->
            <Border Grid.Column="4"
                    Background="{DynamicResource CardBackground}"
                    CornerRadius="8" Padding="16,12"
                    BorderBrush="{DynamicResource Divider}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="ACTIVE SECTIONS" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,3"/>
                    <TextBlock x:Name="KpiSections" Text="—" FontSize="26" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryText}"/>
                    <TextBlock Text="with products" FontSize="11"
                               Foreground="{DynamicResource SecondaryText}" Margin="0,2,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 1 — FILTER TOOLBAR
        ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="0,1,0,1"
                Padding="16,10"
                Margin="0,10,0,0">
            <StackPanel>

                <!-- Controls row -->
                <WrapPanel VerticalAlignment="Center">

                    <!-- Date range preset -->
                    <ComboBox x:Name="DateRangeCombo"
                              Width="145"
                              VerticalContentAlignment="Center"
                              Margin="0,0,16,0"
                              SelectionChanged="DateRangeCombo_SelectionChanged">
                        <ComboBoxItem Content="Last 7 Days"/>
                        <ComboBoxItem Content="This Month" IsSelected="True"/>
                        <ComboBoxItem Content="Last 30 Days"/>
                        <ComboBoxItem Content="This Quarter"/>
                        <ComboBoxItem Content="Year to Date"/>
                    </ComboBox>

                    <!-- Separator -->
                    <Border Width="1" Background="{DynamicResource Divider}" Margin="0,2,16,2"/>

                    <!-- Vendor -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Vendor" VerticalAlignment="Center" Margin="0,0,5,0"
                                   Foreground="{DynamicResource SecondaryText}" FontSize="12"/>
                        <TextBox x:Name="VendorFilter" Width="110" TextChanged="FilterInput_Changed"/>
                    </StackPanel>

                    <!-- Category -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Category" VerticalAlignment="Center" Margin="0,0,5,0"
                                   Foreground="{DynamicResource SecondaryText}" FontSize="12"/>
                        <TextBox x:Name="CategoryFilter" Width="110" TextChanged="FilterInput_Changed"/>
                    </StackPanel>

                    <!-- Group -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Group" VerticalAlignment="Center" Margin="0,0,5,0"
                                   Foreground="{DynamicResource SecondaryText}" FontSize="12"/>
                        <TextBox x:Name="GroupFilter" Width="100" TextChanged="FilterInput_Changed"/>
                    </StackPanel>

                    <!-- Item # -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="Item #" VerticalAlignment="Center" Margin="0,0,5,0"
                                   Foreground="{DynamicResource SecondaryText}" FontSize="12"/>
                        <TextBox x:Name="ProductFilter" Width="110" TextChanged="FilterInput_Changed"/>
                    </StackPanel>

                    <!-- Separator -->
                    <Border Width="1" Background="{DynamicResource Divider}" Margin="0,2,12,2"/>

                    <!-- Color mode radios -->
                    <TextBlock Text="Color by" VerticalAlignment="Center" Margin="0,0,10,0"
                               Foreground="{DynamicResource SecondaryText}" FontSize="12"/>
                    <RadioButton x:Name="RevenueModeBtn"
                                 Content="Revenue"
                                 IsChecked="True"
                                 GroupName="HeatMode"
                                 VerticalAlignment="Center"
                                 Margin="0,0,12,0"
                                 Foreground="{DynamicResource PrimaryText}"
                                 Checked="ColorMode_Changed"/>
                    <RadioButton x:Name="QtyModeBtn"
                                 Content="Units Sold"
                                 GroupName="HeatMode"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource PrimaryText}"
                                 Checked="ColorMode_Changed"/>
                </WrapPanel>

                <!-- Active filter chips (hidden when no filters) -->
                <WrapPanel x:Name="FilterChipsPanel" Margin="0,8,0,0" Visibility="Collapsed"/>

            </StackPanel>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             ROW 2 — FLOOR CANVAS + RIGHT DRAWER
        ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2" ClipToBounds="False">

            <!-- Floor canvas -->
            <Viewbox Stretch="Uniform">
                <Grid Width="1200" Height="600">
                    <Canvas x:Name="LiveFloorCanvas"
                            Background="{DynamicResource SurfaceBackground}"
                            Width="1200"
                            Height="600"/>
                    <Canvas x:Name="RevenueOverlayCanvas"
                            Width="1200"
                            Height="600"
                            Background="Transparent"
                            IsHitTestVisible="False"
                            Panel.ZIndex="20"/>
                </Grid>
            </Viewbox>

            <!-- Color legend (bottom-left corner) -->
            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="16,0,0,16"
                    Panel.ZIndex="10"
                    Background="{DynamicResource CardBackground}"
                    CornerRadius="6" Padding="12,8"
                    BorderBrush="{DynamicResource Divider}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="REVENUE" FontSize="9" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,5"/>
                    <Rectangle Width="120" Height="8" RadiusX="3" RadiusY="3">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#46464B" Offset="0"/>
                                <GradientStop Color="#2A5298" Offset="0.25"/>
                                <GradientStop Color="#F5A623" Offset="0.65"/>
                                <GradientStop Color="#34C759" Offset="1"/>
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Grid Margin="0,4,0,0">
                        <TextBlock Text="None" FontSize="9" HorizontalAlignment="Left"
                                   Foreground="{DynamicResource DisabledText}"/>
                        <TextBlock Text="High" FontSize="9" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource DisabledText}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ─── SECTION DRAWER (slides in from right) ─── -->
            <Border x:Name="SectionDrawer"
                    HorizontalAlignment="Right"
                    Width="320"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1,0,0,0"
                    Panel.ZIndex="50">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="DrawerSlideTransform" X="320"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Direction="180" ShadowDepth="8"
                                      BlurRadius="20" Color="#AA000000"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header: section name + close -->
                    <Border Grid.Row="0"
                            BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1"
                            Padding="16,14">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="SECTION" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,2"/>
                                <TextBlock x:Name="DrawerSectionName" Text="—"
                                           FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryText}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Content="✕"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource SecondaryText}"
                                    FontSize="16" Cursor="Hand"
                                    Padding="8,4"
                                    Click="CloseDrawer_Click"/>
                        </Grid>
                    </Border>

                    <!-- Stats: Revenue | Units Sold | Products -->
                    <Border Grid.Row="1"
                            BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="DrawerRevenue" Text="—"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource Accent}"/>
                                <TextBlock Text="Revenue" FontSize="10"
                                           Foreground="{DynamicResource SecondaryText}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="DrawerQty" Text="—"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryText}"/>
                                <TextBlock Text="Units Sold" FontSize="10"
                                           Foreground="{DynamicResource SecondaryText}" Margin="0,2,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock x:Name="DrawerProductCount" Text="—"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="{DynamicResource PrimaryText}"/>
                                <TextBlock Text="Products" FontSize="10"
                                           Foreground="{DynamicResource SecondaryText}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Product management (scrollable) -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">

                            <!-- Search products -->
                            <TextBlock Text="SEARCH PRODUCTS" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,10"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Vendor" VerticalAlignment="Center" Width="58"
                                           Foreground="{DynamicResource SecondaryText}" FontSize="11"/>
                                <TextBox x:Name="DrawerVendorFilter" Width="190"
                                         TextChanged="DrawerFilter_Changed"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Category" VerticalAlignment="Center" Width="58"
                                           Foreground="{DynamicResource SecondaryText}" FontSize="11"/>
                                <TextBox x:Name="DrawerCategoryFilter" Width="190"
                                         TextChanged="DrawerFilter_Changed"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Item #" VerticalAlignment="Center" Width="58"
                                           Foreground="{DynamicResource SecondaryText}" FontSize="11"/>
                                <TextBox x:Name="DrawerProductFilter" Width="190"
                                         TextChanged="DrawerFilter_Changed"/>
                            </StackPanel>

                            <CheckBox x:Name="DrawerSelectAll"
                                      Content="Select All"
                                      Foreground="{DynamicResource PrimaryText}"
                                      Margin="0,0,0,6"
                                      Checked="DrawerSelectAll_Checked"
                                      Unchecked="DrawerSelectAll_Unchecked"/>

                            <Border BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                                    CornerRadius="4" Margin="0,0,0,8">
                                <ListBox x:Name="DrawerProductsListBox"
                                         MaxHeight="160"
                                         Background="Transparent"
                                         BorderThickness="0"/>
                            </Border>

                            <Button Content="Add to Section"
                                    Style="{StaticResource AccentButton}"
                                    Click="DrawerAddProducts_Click"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,0,16"/>

                            <!-- Divider -->
                            <Border BorderBrush="{DynamicResource Divider}"
                                    BorderThickness="0,1,0,0" Margin="0,0,0,12"/>

                            <!-- Current products in section -->
                            <TextBlock Text="IN THIS SECTION" FontSize="10" FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,8"/>

                            <Border BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                                    CornerRadius="4" Margin="0,0,0,8">
                                <ListBox x:Name="DrawerCurrentProductsListBox"
                                         MaxHeight="200"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         SelectionChanged="DrawerCurrentProducts_SelectionChanged"/>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="Date Placed" VerticalAlignment="Center"
                                           Foreground="{DynamicResource SecondaryText}"
                                           FontSize="11" Margin="0,0,8,0"/>
                                <DatePicker x:Name="DrawerDatePicker" Width="140"
                                            SelectedDateChanged="DrawerDatePicker_Changed"/>
                            </StackPanel>

                            <Button Content="Remove Selected"
                                    Style="{StaticResource NavButton}"
                                    Click="DrawerRemoveProduct_Click"
                                    Padding="12,7"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"
                                    Margin="0,0,0,6"/>

                            <Button Content="View Section Archive"
                                    Style="{StaticResource NavButton}"
                                    Click="DrawerViewArchive_Click"
                                    Padding="12,7"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center"/>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Footer: View Full Analytics -->
                    <Border Grid.Row="3"
                            BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0"
                            Padding="16,12">
                        <Button Content="View Full Analytics →"
                                Style="{StaticResource AccentButton}"
                                Click="DrawerViewFullAnalytics_Click"
                                HorizontalAlignment="Stretch"/>
                    </Border>

                </Grid>
            </Border>

            <!-- Section Detail overlay (full analytics modal) -->
            <Grid x:Name="SectionDetailOverlay"
                  Background="Transparent"
                  Visibility="Collapsed"
                  IsHitTestVisible="False"
                  Panel.ZIndex="100"/>

        </Grid>
    </Grid>
</UserControl>
