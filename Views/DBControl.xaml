<UserControl x:Class="Winton.Views.DBControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="{DynamicResource AppBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource AppBackground}">

        <StackPanel Margin="30" Width="500">

            <!-- SETTINGS PAGE TITLE -->
            <TextBlock Text="Settings"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="{DynamicResource PrimaryText}"
                       Margin="0,0,0,20"/>

            <!-- ==========================
                 SECTION: APP INFO
            =========================== -->
            <Border Background="{DynamicResource CardBackground}"
                    CornerRadius="10"
                    Padding="20"
                    Margin="0,0,0,20"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1">

                <Border.Effect>
                    <DropShadowEffect Color="#33000000"
                                      BlurRadius="15"
                                      ShadowDepth="1"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Application"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryText}"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Version:"
                               Foreground="{DynamicResource SecondaryText}"
                               Margin="0,0,0,5"/>

                    <TextBlock Text="{Binding AppVersion}"
                               Foreground="{DynamicResource PrimaryText}"
                               FontSize="14"/>
                </StackPanel>
            </Border>

            <!-- ==========================
                 SECTION: DATABASE TOOLS
            =========================== -->
            <Border Background="{DynamicResource CardBackground}"
                    CornerRadius="10"
                    Padding="20"
                    Margin="0,0,0,20"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1">

                <Border.Effect>
                    <DropShadowEffect Color="#33000000"
                                      BlurRadius="15"
                                      ShadowDepth="1"/>
                </Border.Effect>

                <StackPanel>

                    <TextBlock Text="Database Tools"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryText}"
                               Margin="0,0,0,20"/>

                    <Button Style="{StaticResource NavButton}"
                            Content="Test Connection"
                            Padding="14,8"
                            Margin="0,0,0,10"
                            Click="TestConnection_Click"/>

                    <Button Style="{StaticResource NavButton}"
                            Content="Backup Database"
                            Padding="14,8"
                            Margin="0,0,0,10"
                            Click="BackupDatabase_Click"/>

                    <Button Style="{StaticResource NavButton}"
                            Content="Restore Database"
                            Padding="14,8"
                            Margin="0,0,0,10"
                            Click="RestoreDatabase_Click"/>

                    <Button Style="{StaticResource NavButton}"
                            Content="Check for Updates"
                            Padding="14,8"
                            Click="CheckForUpdates_Click"/>

                </StackPanel>
            </Border>

            <!-- ==========================
                 FUTURE SETTINGS SECTION
                 (Theme, Preferences, etc.)
            =========================== -->
            <Border Background="{DynamicResource CardBackground}"
                    CornerRadius="10"
                    Padding="20"
                    Margin="0,0,0,20"
                    BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1"
                    Visibility="Collapsed"
                    x:Name="FutureSettingsCard">

                <Border.Effect>
                    <DropShadowEffect Color="#33000000"
                                      BlurRadius="15"
                                      ShadowDepth="1"/>
                </Border.Effect>

                <TextBlock Text="More Settings Coming Soon"
                           Foreground="{DynamicResource SecondaryText}"
                           FontSize="16"/>
            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>
