<UserControl x:Class="Winton.Views.ProductListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <Grid Background="{DynamicResource SurfaceBackground}" Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- =========================================================
             HEADER
        ========================================================= -->
        <Border Background="{DynamicResource CardBackground}"
                CornerRadius="10"
                Padding="12"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="1">

            <Border.Effect>
                <DropShadowEffect Color="#22000000" BlurRadius="16" ShadowDepth="0"/>
            </Border.Effect>

            <TextBlock Text="{Binding ElementName=ProductListView, Path=Items.Count,
                        StringFormat='Product List Count: {0}'}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryText}"
                       HorizontalAlignment="Center"/>
        </Border>

        <!-- =========================================================
             PRODUCT LIST
        ========================================================= -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackground}"
                CornerRadius="10"
                Padding="10"
                Margin="0,20,0,20"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="1">

            <Border.Effect>
                <DropShadowEffect Color="#22000000" BlurRadius="16" ShadowDepth="0"/>
            </Border.Effect>

            <ListView x:Name="ProductListView"
                      ItemsSource="{Binding Products}"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="{DynamicResource PrimaryText}">

                <ListView.Resources>

                    <!-- LISTVIEW ITEM STYLE -->
                    <Style TargetType="ListViewItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,4"/>
                        <Setter Property="SnapsToDevicePixels" Value="True"/>

                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="Container"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="6">
                                        <ContentPresenter Margin="4"/>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Container"
                                                    Property="Background"
                                                    Value="{DynamicResource HoverBackground}"/>
                                        </Trigger>

                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Container"
                                                    Property="Background"
                                                    Value="{DynamicResource SelectedBackground}"/>
                                            <Setter Property="Foreground"
                                                    Value="{DynamicResource PrimaryText}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>

                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>

                    </Style>
                </ListView.Resources>

                <ListView.View>
                    <GridView x:Name="ProductGridView">

                        <!-- ID -->
                        <GridViewColumn Header="ID" Width="80">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ProductID}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Item Name -->
                        <GridViewColumn Header="Item Name" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ItemName}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Item Number -->
                        <GridViewColumn Header="Item Number" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding ItemNumber}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Vendor -->
                        <GridViewColumn Header="Vendor" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Vendor}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Category -->
                        <GridViewColumn Header="Category" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Cat}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <!-- Group -->
                        <GridViewColumn Header="Group" Width="120">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Grp}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                    </GridView>
                </ListView.View>


            </ListView>

        </Border>


        <!-- =========================================================
             BOTTOM BUTTONS
        ========================================================= -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0">

            <Button Content="Import Product List"
                    Style="{StaticResource NavButton}"
                    Width="170" Height="40"
                    Margin="10,0"
                    Click="ImportProductList_Click"/>

            <Button Content="Delete Product List"
                    Style="{StaticResource NavButton}"
                    Width="170" Height="40"
                    Margin="10,0"
                    Click="DeleteProductList_Click"/>

        </StackPanel>

    </Grid>
</UserControl>
