<UserControl x:Class="Winton.Views.EditableSalesFloor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Background="{DynamicResource AppBackground}"
             Unloaded="EditableSalesFloor_Unloaded">

    <Grid Background="{DynamicResource SurfaceBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===================================================== -->
        <!-- FLOATING EDIT TOOLBAR — MATCHES LIVESALESFLOOR        -->
        <!-- ===================================================== -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBackground}"
                CornerRadius="8"
                Padding="8"
                Margin="15"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="1">

            <Border.Effect>
                <DropShadowEffect Color="#44000000"
                                  BlurRadius="12"
                                  ShadowDepth="2"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Normal Mode Buttons -->
                <StackPanel x:Name="NormalToolsPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button Style="{StaticResource NavButton}"
                            Content="Enable Edit Mode"
                            Click="EditFloor_Click"
                            Padding="12,6"
                            Margin="0,0,10,0"/>

                    <Button Style="{StaticResource NavButton}"
                            Content="Help"
                            Click="Help_Click"
                            Padding="12,6"/>
                </StackPanel>

                <!-- Spacing -->
                <Rectangle Width="12"/>

                <!-- Edit Mode Buttons -->
                <StackPanel x:Name="EditToolsPanel"
                            Orientation="Horizontal"
                            Visibility="Collapsed"
                            VerticalAlignment="Center">

                    <Button Style="{StaticResource NavButton}"
                            x:Name="PerimeterButton"
                            Content="Perimeter"
                            Click="PerimeterButton_Click"
                            Padding="12,6"
                            Margin="0,0,10,0"/>

                    <Button Style="{StaticResource NavButton}"
                            x:Name="FloorDesignButton"
                            Content="Floor"
                            Click="FloorDesign_Click"
                            Padding="12,6"
                            Margin="0,0,10,0"/>

                    <Button Style="{StaticResource NavButton}"
                            Content="Add Sections"
                            Click="AddSection_Click"
                            Padding="12,6"
                            Margin="0,0,10,0"/>

                    <Button Style="{StaticResource NavButton}"
                            Content="Save"
                            Click="SaveChanges_Click"
                            Padding="12,6"
                            Margin="0,0,10,0"/>

                    <Button Style="{StaticResource NavButton}"
                            Content="Save &amp; Exit"
                            Click="ExitEditMode_Click"
                            Padding="12,6"
                            Foreground="{DynamicResource Accent}"/>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- ========================================================= -->
        <!-- SALES FLOOR CANVAS AREA (NO VIEWBOX — No gray bars)      -->
        <!-- ========================================================= -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Background="{DynamicResource SurfaceBackground}">

            <Canvas x:Name="SalesFloorCanvas"
                    Background="{DynamicResource SurfaceBackground}"
                    Width="1600"
                    Height="900"
                    MouseLeftButtonDown="SalesFloorCanvas_MouseLeftButtonDown">

                <Canvas.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy" Click="CopyMenuItem_Click"/>
                        <MenuItem Header="Paste" Click="PasteMenuItem_Click"/>
                    </ContextMenu>
                </Canvas.ContextMenu>

            </Canvas>
        </ScrollViewer>

        <!-- ========================================================= -->
        <!-- SIDEBAR PANEL (Light Theme Card)                          -->
        <!-- ========================================================= -->
        <Border x:Name="SectionsPanel"
                Background="{DynamicResource CardBackground}"
                Width="200"
                Height="300"
                VerticalAlignment="Top"
                HorizontalAlignment="Right"
                Margin="0,60,10,0"
                Visibility="Collapsed"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="1"
                Effect="{DynamicResource CardShadow}">

            <StackPanel Margin="10">
                <TextBlock Text="Add Sections"
                           Foreground="{DynamicResource PrimaryText}"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="0,5"/>

                <Button Content="Square" Click="AddSquare_Click" Margin="5"/>
                <Button Content="Circle" Click="AddCircle_Click" Margin="5"/>
                <Button Content="Triangle" Click="AddTriangle_Click" Margin="5"/>
                <Button Content="Cross" Click="AddCross_Click" Margin="5"/>
                <Button Content="Draw Custom" Click="DrawCustomSection_Click" Margin="5"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
