<UserControl x:Class="Winton.Views.EditableSalesFloor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
			 Unloaded="EditableSalesFloor_Unloaded">
	<Grid>
		<!-- Main Layout -->
		<Grid.RowDefinitions>
			<RowDefinition Height="50"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- NAVIGATION BAR -->
		<Grid Grid.Row="0" Background="#2D2D30" Height="50">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<!-- Left-Aligned Buttons -->
			<StackPanel Orientation="Horizontal" Grid.Column="0">
				<Button Content="Enable Edit Mode" Padding="10,5" Margin="5" Background="Transparent" Foreground="White" BorderThickness="0" Click="EditFloor_Click"/>
                <Button Content="Help" Padding="10,5" Margin="5" Background="Transparent" Foreground="White" BorderThickness="0" Click="Help_Click"/>


            </StackPanel>

			<!-- Right-Aligned Buttons -->
			<StackPanel x:Name="EditToolsPanel" Orientation="Horizontal" Grid.Column="2" Visibility="Collapsed">
				<Button x:Name="PerimeterButton" Content="Perimeter Design" Padding="10,5" Margin="5"
                        Background="Transparent" Foreground="White" BorderThickness="0"
                        Click="PerimeterButton_Click"/>
				<Button x:Name="FloorDesignButton" Content="Floor Design" Padding="10,5" Margin="5"
                        Background="Transparent" Foreground="White" BorderThickness="0"
                        Click="FloorDesign_Click"/>
				<Button Content="Add Sections" Padding="10,5" Margin="5"
                        Background="Transparent" Foreground="White" BorderThickness="0"
                        Click="AddSection_Click"/>
				<Button Content="Save" Padding="10,5" Margin="5"
						Background="Transparent" Foreground="White" BorderThickness="0" 
						Click="SaveChanges_Click"/>
				<Button Content="Save and Exit" Padding="10,5" Margin="5"
                        Background="Transparent" Foreground="Red" BorderThickness="0"
                        Click="ExitEditMode_Click"/>
			</StackPanel>
		</Grid>

		<!-- Canvas for Designing Sales Floor, Wrapped in a ViewBox for Uniform Scaling -->
		<Viewbox Grid.Row="1" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
			<!-- Set your design canvas size (e.g. 1200 x 500) -->
			<Canvas x:Name="SalesFloorCanvas" Background="LightGray" Width="1200" Height="500" MouseLeftButtonDown="SalesFloorCanvas_MouseLeftButtonDown"/>
		</Viewbox>

		<!-- Sidebar Panel for Sections (remains fixed if desired) -->
		<Border x:Name="SectionsPanel" Background="#333" Width="200" Height="300"
                VerticalAlignment="Top" HorizontalAlignment="Right"
                Margin="0,55,10,0" Visibility="Collapsed"
                BorderBrush="White" BorderThickness="1">
			<StackPanel Margin="10">
				<TextBlock Text="Add Sections" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,5"/>
				<Button Content="Square" Click="AddSquare_Click" Margin="5"/>
				<Button Content="Circle" Click="AddCircle_Click" Margin="5"/>
				<Button Content="Triangle" Click="AddTriangle_Click" Margin="5"/>
				<Button Content="Cross" Click="AddCross_Click" Margin="5"/>
				<Button Content="Draw Custom" Click="DrawCustomSection_Click" Margin="5"/>
			</StackPanel>
		</Border>
	</Grid>
</UserControl>
