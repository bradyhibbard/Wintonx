<Window x:Class="Winton.Views.FileNameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Save Report"
        Height="330"
        Width="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackground}"
        ResizeMode="NoResize">

    <Grid Background="{DynamicResource AppBackground}">

        <!-- Floating Card -->
        <Border Background="{DynamicResource CardBackground}"
                CornerRadius="12"
                Padding="20"
                Width="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BorderBrush="{DynamicResource Divider}"
                BorderThickness="1">

            <Border.Effect>
                <DropShadowEffect Color="#33000000"
                                  BlurRadius="20"
                                  ShadowDepth="1"/>
            </Border.Effect>

            <StackPanel>

                <!-- Title -->
                <TextBlock Text="Save Report"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryText}"
                           Margin="0,0,0,20"
                           HorizontalAlignment="Center"/>

                <!-- Selected File -->
                <TextBlock Text="Selected File"
                           Foreground="{DynamicResource SecondaryText}"
                           FontSize="14"/>
                <TextBox x:Name="txtFileName"
                         Margin="0,5,0,20"/>

                <!-- Report Date -->
                <TextBlock Text="Report Date"
                           Foreground="{DynamicResource SecondaryText}"
                           FontSize="14"/>
                <DatePicker x:Name="datePicker"
                            Margin="0,5,0,20"/>

                <!-- Buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Cancel"
                            Style="{StaticResource NavButton}"
                            Margin="0,0,10,0"
                            Width="90"
                            Click="Cancel_Click"/>

                    <Button Content="Save"
                            Style="{StaticResource NavButton}"
                            Width="90"
                            Click="Ok_Click"/>

                </StackPanel>

            </StackPanel>
        </Border>
    </Grid>
</Window>
