<Window x:Class="Winton.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Help" Height="500" Width="600" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="#2D2D30" Foreground="White">
    <ScrollViewer Margin="20">
        <StackPanel>
            <TextBlock Text="Welcome to the Sales Floor Editor" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock TextWrapping="Wrap">
                <Run Text="• Click 'Enable Edit Mode' to begin editing the canvas." /><LineBreak/>
                <Run Text="• Use 'Perimeter Design' to draw the outer boundary of the sales floor." /><LineBreak/>
                <Run Text="• Use 'Floor Design' to draw partition walls (Shift+Click for multi-point lines)." /><LineBreak/>
                <Run Text="• Click 'Add Sections' to open section shapes (square, circle, etc.)." /><LineBreak/>
                <Run Text="• Ctrl+Z to undo your last point or finalized shape." /><LineBreak/>
                <Run Text="• Click on sections or partitions to select, move, or delete them." /><LineBreak/>
                <Run Text="• 'Save' to persist changes. 'Save and Exit' to exit edit mode." />
            </TextBlock>

            <TextBlock Text="Keyboard Shortcuts" FontSize="16" FontWeight="Bold" Margin="0,20,0,5"/>
            <TextBlock TextWrapping="Wrap">
                <Run Text="• Ctrl+Z — Undo"/><LineBreak/>
                <Run Text="• Delete — Remove selected shape"/><LineBreak/>
                <Run Text="• Shift — Hold to draw multi-point partitions"/>
            </TextBlock>


            <Button Content="Close" Width="80" Margin="0,30,0,0" HorizontalAlignment="Right" Click="Close_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>
