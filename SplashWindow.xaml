<Window x:Class="Winton.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Width="600"
        Height="350"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Opacity="0">

    <Border Background="White"
            CornerRadius="18"
            Padding="20"
            SnapsToDevicePixels="True">

        <Border.Effect>
            <DropShadowEffect Color="#44000000"
                              BlurRadius="35"
                              ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Logo or central image -->
            <Image Source="Assets/Splash.png"
                   Width="280"
                   Height="160"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />

            <!-- Status -->
            <StackPanel Grid.Row="1" Margin="0,18,0,0" HorizontalAlignment="Center">
                <TextBlock x:Name="StatusText"
                           Text="Loading Wintonx..."
                           FontSize="16"
                           Foreground="#444"
                           HorizontalAlignment="Center"/>

                <ProgressBar x:Name="BusyBar"
                             Width="240"
                             Height="8"
                             Margin="0,10,0,0"
                             IsIndeterminate="True"/>
            </StackPanel>

            <!-- Skip -->
            <Button x:Name="SkipButton"
                    Grid.Row="2"
                    Content="Skip"
                    Width="120"
                    Height="34"
                    Margin="0,18,0,0"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed"
                    Click="SkipButton_Click"/>
        </Grid>

    </Border>
</Window>
