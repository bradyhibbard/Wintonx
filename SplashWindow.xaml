<Window x:Class="Winton.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Width="600"
        Height="350"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        Opacity="0">

    <Border Background="#DDFFFFFF"
            CornerRadius="18"
            Padding="20"
            SnapsToDevicePixels="True">

        <Border.Effect>
            <DropShadowEffect Color="#44000000"
                              BlurRadius="35"
                              ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Logo or central image -->
            <Image Source="Assets/Splash.png"
                   Width="280"
                   Height="160"
                   Stretch="Uniform"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center" Margin="131,0,0,0"/>

            <!-- Loading text -->
            <TextBlock Text="Loading Wintonx..."
                       Grid.Row="1"
                       Margin="0,20,0,0"
                       HorizontalAlignment="Center"
                       FontSize="16"
                       Foreground="#444"/>
        </Grid>

    </Border>
</Window>
