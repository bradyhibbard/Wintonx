<Window x:Class="Winton.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Winton" Height="700" Width="1200">
	<Grid>
		<!-- Background image with overlay -->
		<Image x:Name="BackgroundImage" Source="/Assets/Couch.jpg" Stretch="Fill"/>

		<Border Background="#A0000000" Visibility="Visible" x:Name="StartOverlay">
			<Button Content="Start Here" HorizontalAlignment="Center" VerticalAlignment="Center" Width="100" Height="50" Click="StartButton_Click" Foreground="White" Background="Transparent">
				<Button.Style>
					<Style TargetType="Button">
						<Setter Property="Background" Value="Transparent"/>
						<Setter Property="Foreground" Value="White"/>
						<Setter Property="BorderBrush" Value="White"/>
						<Setter Property="BorderThickness" Value="2"/>
						<Style.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="LightGray"/>
							</Trigger>
						</Style.Triggers>
					</Style>
				</Button.Style>
			</Button>
		</Border>

		<DockPanel LastChildFill="True" Background="#2D2D30" Visibility="Collapsed" x:Name="MainDockPanel">
			<!-- Top Navigation Bar -->
			<StackPanel x:Name="Sidebar" DockPanel.Dock="Top" Orientation="Horizontal" Background="#2D2D30" Height="50">
				<ToggleButton x:Name="CollapseButton" Background="#2D2D30" Foreground="White" Width="40" Height="40"
				              VerticalAlignment="Center" Padding="5" Click="CollapseButton_Click">
					<TextBlock Text="≡" FontSize="16" />
				</ToggleButton>


				<Button Content="Dashboard" Padding="10,5" Margin="5" Background="Transparent" Foreground="White" BorderThickness="0" Click="Dashboard_Click"/>
				<Button Content="Sales Floor" Padding="10,5" Margin="5" Background="Transparent" Foreground="White" BorderThickness="0" Click="SalesFloor_Click"/>
				<Button Content="Product List" Padding="10,5" Margin="5" Background="Transparent" Foreground="White" BorderThickness="0" Click="ProductList_Click"/>
				<Button Content="Reports" Padding="10,5" Margin="5" Background="Transparent" Foreground="White" BorderThickness="0" Click="Reports_Click"/>
				<Button Content="Canvas" Padding="10,5" Margin="5" Background="Transparent" Foreground="White" BorderThickness="0" Click="Canvas_Click"/>
                <Button Content="Settings" Padding="10,5" Margin="5" Background="Transparent" Foreground="White" BorderThickness="0" Click="DB_Click"/>
            </StackPanel>

			<StackPanel x:Name="expand" DockPanel.Dock="Top" Orientation="Horizontal" Background="#2D2D30" Height="50">
				<!-- Expand Button (Hidden Initially, Same Position as CollapseButton) -->
				<Button x:Name="ExpandButton" Content=">" Width="40" Height="40" Visibility="Collapsed"
					Background="Transparent" Foreground="White" Click="ExpandButton_Click"
					HorizontalAlignment="Left" VerticalAlignment="Center"/>
			</StackPanel>

			<!-- Main Content Area -->
			<Border Background="#333333" Padding="20" DockPanel.Dock="Top">
				<ContentControl x:Name="MainContent" Background="#333333" Padding="20"/>
			</Border>
		</DockPanel>
	</Grid>
</Window>
