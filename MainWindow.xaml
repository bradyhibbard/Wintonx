<Window x:Class="Winton.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        Background="Transparent"
        MinHeight="600"
        MinWidth="1000">

    <!-- OUTER WINDOW FRAME -->
    <Border Background="#F2FFFFFF"
            CornerRadius="12"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#66000000"
                              BlurRadius="30"
                              ShadowDepth="0"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TITLE BAR -->
            <Grid Grid.Row="0"
                  Height="40"
                  Background="{DynamicResource AppBackground}"
                  MouseDown="TitleBar_MouseDown">

                <TextBlock Text="Wintonx"
                           VerticalAlignment="Center"
                           Margin="15,0,0,0"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryText}"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,10,0">

                    <Button Content="—"
                            Width="46" Height="30"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="Minimize_Click"/>

                    <Button x:Name="MaximizeButton"
                            Content="□"
                            Width="46" Height="30"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="Maximize_Click"/>

                    <Button Content="✕"
                            Width="46" Height="30"
                            Style="{StaticResource TitleBarButtonStyle}"
                            Click="Close_Click"/>
                </StackPanel>
            </Grid>

            <!-- MAIN CONTENT ROW -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDEBAR -->
                <Border Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource Divider}"
                        BorderThickness="0,0.5,0.5,0"
                        Padding="10">

                    <StackPanel x:Name="Sidebar">

                        <!-- NAV BUTTONS -->
                        <Button Style="{StaticResource NavButton}"
                                Content="Dashboard"
                                Click="Dashboard_Click"
                                Margin="0 4"/>

                        <Button Style="{StaticResource NavButton}"
                                Content="Sales Floor"
                                Click="SalesFloor_Click"
                                Margin="0 4"/>

                        <Button Style="{StaticResource NavButton}"
                                Content="Product List"
                                Click="ProductList_Click"
                                Margin="0 4"/>

                        <Button Style="{StaticResource NavButton}"
                                Content="Reports"
                                Click="Reports_Click"
                                Margin="0 4"/>

                        <Button Style="{StaticResource NavButton}"
                                Content="Canvas"
                                Click="Canvas_Click"
                                Margin="0 4"/>

                        <Button Style="{StaticResource NavButton}"
                                Content="Settings"
                                Click="DB_Click"
                                Margin="0 4"/>

                        <!-- Dummy ExpandButton so existing code-behind compiles -->
                        <Button x:Name="ExpandButton"
                                Visibility="Collapsed"
                                Width="0"
                                Height="0" />

                    </StackPanel>
                </Border>

                <!-- MAIN CONTENT AREA -->
                <Border Grid.Column="1"
                        Background="{DynamicResource SurfaceBackground}"
                        Padding="20">

                    <ContentControl x:Name="MainContent"
                                    Background="{DynamicResource SurfaceBackground}"
                                    Padding="20"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
